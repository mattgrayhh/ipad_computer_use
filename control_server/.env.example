# Used by: node --env-file=control_server/.env control_server/mcp_server.js
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional signed WebDriverAgent running on the paired iPad:
# WDA_URL=http://IPAD_LAN_IP:8100
# Slack uses native observations automatically when WDA is configured.
# Set this to use native observations for custom plans too:
# JEV_OBSERVATION=accessibility
